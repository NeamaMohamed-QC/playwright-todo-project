import { test, expect } from '@playwright/test'
import { faker } from '@faker-js/faker'
import User from '../models/User'
import RegisterPage from '../Pages/RegisterPage'
// first test case will be signup


test("user should be registred to the todo website successfully", async ({ page }) => {
const user = new User (faker.person.firstName(), faker.person.lastName(), faker.internet.email(), "Neama@#123")


const registerPage = new RegisterPage (page)
await registerPage.load ()
await registerPage.RegisterSteps (user)



  await page.goto("/signup")
  await page.getByTestId("first-name").fill(user.getFirstName())
  await page.getByTestId("last-name").fill(user.getLastName())
  //  await page.getByRole("textbox",{name: "last-name"}).fill ("mohamed")
  await page.getByTestId("email").fill(user.getEmail())
  await page.getByTestId("password").fill(user.getPassword())
  await page.getByTestId("confirm-password").fill(user.getPassword())
  await page.getByRole("button", { name: "Signup" }).click()

  const welocmemessage = page.getByTestId("welcome")
  await expect(welocmemessage).toBeVisible()


})